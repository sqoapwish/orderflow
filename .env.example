# Safe local-development values. Copy this file to .env and change passwords if needed.
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_local_password
API_PORT=8002
FRONTEND_PORT=3000
DB_PORT=5435
TEST_DB_PORT=5436
RABBITMQ_MANAGEMENT_PORT=15673

ORDERFLOW_ENVIRONMENT=local
ORDERFLOW_DEBUG=false
ORDERFLOW_LOG_LEVEL=INFO
ORDERFLOW_DATABASE_URL=postgresql+asyncpg://orderflow:orderflow_local_password@db:5432/orderflow
ORDERFLOW_REDIS_URL=redis://redis:6379/0
ORDERFLOW_RABBITMQ_URL=amqp://orderflow:orderflow_local_password@rabbitmq:5672//
ORDERFLOW_JWT_SECRET=local-development-jwt-secret-change-me
ORDERFLOW_JWT_ACCESS_TOKEN_TTL_MINUTES=15
ORDERFLOW_JWT_REFRESH_TOKEN_TTL_DAYS=30
ORDERFLOW_PAYMENT_WEBHOOK_SECRET=local-development-payment-webhook-secret-change-me
ORDERFLOW_PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
ORDERFLOW_PAYMENT_SESSION_TTL_MINUTES=30
ORDERFLOW_OUTBOX_DISPATCH_BATCH_SIZE=50
ORDERFLOW_OUTBOX_DISPATCH_INTERVAL_SECONDS=5
ORDERFLOW_OUTBOX_MAX_ATTEMPTS=5
ORDERFLOW_OUTBOX_RETRY_BASE_SECONDS=5
ORDERFLOW_OUTBOX_RETRY_MAX_SECONDS=300
ORDERFLOW_ANALYTICS_CACHE_TTL_SECONDS=30
ORDERFLOW_DEMO_CUSTOMER_PASSWORD=Customer-demo-2026
ORDERFLOW_DEMO_MANAGER_PASSWORD=Manager-demo-2026
ORDERFLOW_DEMO_ADMIN_PASSWORD=Admin-demo-2026
PROMETHEUS_PORT=9090
