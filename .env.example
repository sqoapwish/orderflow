# Safe local-development values. Copy this file to .env and change passwords if needed.
POSTGRES_DB=orderflow
POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow_local_password
API_PORT=8002
DB_PORT=5435
TEST_DB_PORT=5436
RABBITMQ_MANAGEMENT_PORT=15673

ORDERFLOW_ENVIRONMENT=local
ORDERFLOW_DEBUG=false
ORDERFLOW_LOG_LEVEL=INFO
ORDERFLOW_DATABASE_URL=postgresql+asyncpg://orderflow:orderflow_local_password@db:5432/orderflow
ORDERFLOW_REDIS_URL=redis://redis:6379/0
ORDERFLOW_RABBITMQ_URL=amqp://orderflow:orderflow_local_password@rabbitmq:5672//
ORDERFLOW_JWT_SECRET=local-development-jwt-secret-change-me
ORDERFLOW_JWT_ACCESS_TOKEN_TTL_MINUTES=15
ORDERFLOW_JWT_REFRESH_TOKEN_TTL_DAYS=30
